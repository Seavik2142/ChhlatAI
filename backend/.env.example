# Copy to .env and adjust.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://chhlat:chhlat@localhost:5432/chhlatai
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
# Public URL of this API (Telegram/Meta webhooks and tracking links need HTTPS in production)
PUBLIC_BASE_URL=http://localhost:8000

# Optional — without a key the built-in rule-based assistant replies.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

META_VERIFY_TOKEN=omnichat-verify
META_APP_SECRET=

# OAuth 2.0 Credentials (Facebook / Instagram / TikTok)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/auth/tiktok/callback

FRONTEND_BASE_URL=http://localhost:5173

